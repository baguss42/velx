# VelX backend configuration. Copy to .env for local development.
# Blank optional credentials disable their integrations. Never commit populated .env files.

APP_ENV=development
APP_VERSION=local
APP_BASE_URL=http://localhost:5173
SHOWROOM_NAME=VelX Development Showroom
BRAND_NAME=Fictional VelX Motors (development only)
DEFAULT_LOCALE=id-ID
DEFAULT_CURRENCY=IDR
SHOWROOM_TIMEZONE=Asia/Jakarta
TENANT_ID=00000000-0000-0000-0000-000000000001
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Separate PostgreSQL roles. Leave blank until the database slice is configured locally.
DATABASE_URL=
BUSINESS_DATABASE_URL=
MIGRATION_DATABASE_URL=
CHECKPOINT_DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_STATEMENT_TIMEOUT_MS=3000
BUSINESS_DATA_MODE=authoritative_postgres
BUSINESS_DATA_MAX_AGE_SECONDS=60

# Retrieval is disabled while RAGFLOW_DATASET_IDS is empty.
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
RAGFLOW_DATASET_IDS=[]
RAGFLOW_TIMEOUT_SECONDS=8
RAGFLOW_RESULT_LIMIT=5

# Mock provider is explicit and local-only. Real provider keys are server-side secrets.
LLM_PROVIDER=mock
LLM_MODEL=velx-local-mock
LLM_ALLOWED_PROVIDERS=["mock","openai","anthropic","deepseek"]
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
LLM_TIMEOUT_SECONDS=15
LLM_MAX_OUTPUT_TOKENS=1500
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
PROMPT_VERSION=showroom-v1
MAX_TOOL_ROUNDS=4
MAX_TOOL_CALLS=8
MAX_PARALLEL_TOOLS=3
CHAT_DEADLINE_SECONDS=30

# Fake auth is explicit and local-only. Production requires OIDC configuration.
AUTH_MODE=fake
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
GUEST_SESSION_TTL_SECONDS=86400
CSRF_SECRET=
PII_ENCRYPTION_KEY_REF=
RATE_LIMIT_REQUESTS_PER_MINUTE=20
ACTION_ALLOWED_HOSTS=[]
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=

OTEL_SERVICE_NAME=showroom-chatbot
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development,service.version=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_always_on
TELEMETRY_CAPTURE_CONTENT=false
LOG_LEVEL=INFO
CONVERSATION_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
